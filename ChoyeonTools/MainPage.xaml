<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChoyeonTools.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ChoyeonTools.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ChoyeonTools.ViewModels"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="R"
            Modifiers="Control"
            Invoked="OnRefreshAccelerator" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <DataTemplate x:Key="FieldRowTemplate" x:DataType="vm:FieldRow">
            <Grid Padding="0,5" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Bind Label}" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource FieldValueStyle}"
                    Text="{x:Bind Value, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GroupCardTemplate" x:DataType="vm:GroupCard">
            <Border
                Style="{StaticResource InfoCardStyle}"
                Tag="{x:Bind}"
                Loaded="OnGroupCardLoaded"
                Unloaded="OnGroupCardUnloaded">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Rectangle Style="{StaticResource AccentRuleStyle}" />
                        <TextBlock Style="{StaticResource GroupTitleStyle}" Text="{x:Bind Title}" />
                    </StackPanel>
                    <Border Style="{StaticResource DividerStyle}" />
                    <ItemsControl ItemTemplate="{StaticResource FieldRowTemplate}" ItemsSource="{x:Bind Fields}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SummaryRowTemplate" x:DataType="vm:SummaryRow">
            <Grid Padding="0,4" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <TextBlock
                    Width="72"
                    VerticalAlignment="Top"
                    Margin="0,4,0,0"
                    FontSize="{StaticResource FontBody}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Label}" />
                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SummaryDevice">
                            <HyperlinkButton
                                Padding="0,2"
                                HorizontalContentAlignment="Left"
                                Click="OnSummaryDeviceClick"
                                Content="{x:Bind Text}"
                                FontSize="{StaticResource FontBody}"
                                Tag="{x:Bind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MetricCardTemplate" x:DataType="vm:MetricCard">
            <Border Margin="0,0,12,12" Style="{StaticResource MetricCardStyle}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource GapMd}">
                    <Border Style="{StaticResource MetricGraphFrameStyle}" Visibility="{x:Bind GraphVisibility, Mode=OneTime}">
                        <controls:UsageGraph
                            GridBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            History="{x:Bind History, Mode=OneWay}"
                            LineColor="{x:Bind Accent, Mode=OneTime}"
                            Maximum="{x:Bind GraphMaximum, Mode=OneTime}" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="{x:Bind Label, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{x:Bind Value, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource MetricDetailStyle}"
                            Text="{x:Bind Detail, Mode=OneWay}"
                            Visibility="{x:Bind DetailVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <NavigationView
            x:Name="Nav"
            AutomationProperties.Name="信息分类"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="总览" IsSelected="True" Tag="overview">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="CPU" Tag="cpu">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xEEA1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="内存" Tag="memory">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xEEA0;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  字体里没有独立的显卡字形，用无内核的芯片轮廓与 CPU 区分  -->
                <NavigationViewItem Content="GPU" Tag="gpu">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="硬盘" Tag="disk">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xEDA2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="声卡" Tag="sound">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE7F5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="网络" Tag="network">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="USB" Tag="usb">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xECF0;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="系统" Tag="system">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE770;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="显示器" Tag="monitor">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <!--  设置入口固定在导航底部，和任务管理器一致；内置设置项的文案不可控，所以用普通项自建  -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!--  页面动作放在内容区右键菜单里，和任务管理器的标签页菜单一致  -->
            <Grid x:Name="ContentRoot" ContextRequested="OnContentContextRequested" RowDefinitions="Auto,*,Auto">
                <FlyoutBase.AttachedFlyout>
                    <MenuFlyout x:Name="PageFlyout">
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.RefreshCommand, Mode=OneTime}"
                            KeyboardAcceleratorTextOverride="Ctrl+R"
                            Text="刷新">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE72C;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.CopyCommand, Mode=OneTime}"
                            Text="复制本页"
                            Visibility="{x:Bind ViewModel.IsDataView, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.ExportCommand, Mode=OneTime}"
                            Text="导出 JSON">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE78C;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </FlyoutBase.AttachedFlyout>
                <!--  页头只留标题与说明；进度条压在分隔线上，busy 时不改变布局  -->
                <Grid>
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Padding="24,16,24,14" Spacing="{StaticResource GapXs}">
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level1"
                                Style="{StaticResource PageTitleStyle}"
                                Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource PageDescriptionStyle}"
                                Text="{x:Bind ViewModel.SelectedDescription, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <ProgressBar
                        Height="3"
                        Background="Transparent"
                        IsIndeterminate="True"
                        VerticalAlignment="Bottom"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </Grid>

                <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Padding="{StaticResource PagePadding}">
                    <StackPanel Spacing="{StaticResource GapMd}">
                        <!--  分类页  -->
                        <StackPanel Spacing="{StaticResource GapMd}" Visibility="{x:Bind ViewModel.IsDataView, Mode=OneWay}">
                            <!--  实时资源占用只在总览页显示，保持在最上方  -->
                            <GridView
                                x:Name="MetricsGrid"
                                IsHitTestVisible="False"
                                ItemContainerStyle="{StaticResource MetricItemContainerStyle}"
                                ItemTemplate="{StaticResource MetricCardTemplate}"
                                ItemsSource="{x:Bind ViewModel.Metrics}"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                SelectionMode="None"
                                SizeChanged="OnMetricsSizeChanged"
                                Visibility="{x:Bind ViewModel.IsOverview, Mode=OneWay}">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid ItemHeight="96" ItemWidth="292" Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                            </GridView>

                            <!--  总览：图吧式简要汇总，型号与系统头卡 + 可点击跳转的设备清单  -->
                            <StackPanel Spacing="{StaticResource GapMd}" Visibility="{x:Bind ViewModel.IsOverview, Mode=OneWay}">
                                <Border Style="{StaticResource InfoCardStyle}">
                                    <StackPanel Spacing="{StaticResource GapXs}">
                                        <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="型号信息" Margin="0" />
                                        <TextBlock
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind ViewModel.Summary.Model, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InfoCardStyle}">
                                    <StackPanel Spacing="{StaticResource GapXs}">
                                        <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="系统信息" Margin="0" />
                                        <TextBlock
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind ViewModel.Summary.System, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InfoCardStyle}">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Rectangle Style="{StaticResource AccentRuleStyle}" />
                                            <TextBlock Style="{StaticResource GroupTitleStyle}" Text="详细信息" />
                                        </StackPanel>
                                        <Border Style="{StaticResource DividerStyle}" />
                                        <ItemsControl
                                            ItemTemplate="{StaticResource SummaryRowTemplate}"
                                            ItemsSource="{x:Bind ViewModel.Summary.Rows, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="尚未取得数据，请在“设置”中重新采集。"
                                Visibility="{x:Bind ViewModel.HasNoSelection, Mode=OneWay}" />

                            <ItemsControl
                                x:Name="GroupsList"
                                HorizontalContentAlignment="Stretch"
                                ItemTemplate="{StaticResource GroupCardTemplate}"
                                ItemsSource="{x:Bind ViewModel.Groups}"
                                Visibility="{x:Bind ViewModel.ShowsGroups, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="{StaticResource GapMd}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <!--  设置页：外观、常规、数据与关于，行式卡片参考任务管理器  -->
                        <StackPanel Spacing="{StaticResource GapMd}" Visibility="{x:Bind ViewModel.IsSettings, Mode=OneWay}">
                            <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="外观" />
                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource GapLg}">
                                    <FontIcon Style="{StaticResource SettingIconStyle}" Glyph="&#xE790;" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="{StaticResource GapXs}">
                                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="应用主题" />
                                        <TextBlock Style="{StaticResource SettingHintStyle}" Text="跟随系统、浅色或深色" />
                                    </StackPanel>
                                    <ComboBox
                                        x:Name="ThemeSelector"
                                        Grid.Column="2"
                                        Width="180"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="主题"
                                        SelectionChanged="OnThemeSelectionChanged">
                                        <ComboBoxItem Content="跟随系统" Tag="System" />
                                        <ComboBoxItem Content="浅色" Tag="Light" />
                                        <ComboBoxItem Content="深色" Tag="Dark" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="常规" />
                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource GapLg}">
                                    <FontIcon Style="{StaticResource SettingIconStyle}" Glyph="&#xE895;" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="{StaticResource GapXs}">
                                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="实时刷新" />
                                        <TextBlock Style="{StaticResource SettingHintStyle}" Text="自动重新采集全部信息的间隔" />
                                    </StackPanel>
                                    <ComboBox
                                        x:Name="AutoRefreshSelector"
                                        Grid.Column="2"
                                        Width="180"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="自动刷新"
                                        SelectionChanged="OnAutoRefreshSelectionChanged">
                                        <ComboBoxItem Content="关闭" Tag="0" />
                                        <ComboBoxItem Content="10 秒" Tag="10" />
                                        <ComboBoxItem Content="30 秒" Tag="30" />
                                        <ComboBoxItem Content="60 秒" Tag="60" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="数据" />
                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource GapLg}">
                                    <FontIcon Style="{StaticResource SettingIconStyle}" Glyph="&#xE8C8;" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="{StaticResource GapXs}">
                                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="页面操作" />
                                        <TextBlock
                                            Style="{StaticResource SettingHintStyle}"
                                            Text="在页面内容上点击右键即可刷新、复制本页或导出 JSON（长按等效右键，Ctrl + R 直接刷新）。导出的 JSON 仍包含没读到的字段，方便核对。" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="关于" />
                            <ContentControl
                                HorizontalContentAlignment="Stretch"
                                Content="{x:Bind ViewModel.AboutCard}"
                                ContentTemplate="{StaticResource GroupCardTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock
                    Grid.Row="2"
                    Margin="24,0,24,10"
                    Style="{StaticResource StatusTextStyle}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            </Grid>
        </NavigationView>
    </Grid>
</Page>
