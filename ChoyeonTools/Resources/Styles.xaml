<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        全局设计令牌：间距、字级、圆角与卡片样式集中在这里，
        页面 XAML 只引用令牌，不再写零散的字号与边距。
    -->

    <!--  间距刻度（4 的倍数）  -->
    <x:Double x:Key="GapXs">4</x:Double>
    <x:Double x:Key="GapMd">12</x:Double>
    <x:Double x:Key="GapLg">16</x:Double>

    <!--  字级刻度  -->
    <x:Double x:Key="FontCaption">12</x:Double>
    <x:Double x:Key="FontBody">13</x:Double>
    <x:Double x:Key="FontSectionTitle">15</x:Double>
    <x:Double x:Key="FontPageTitle">24</x:Double>

    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <Thickness x:Key="CardPadding">20,16</Thickness>
    <Thickness x:Key="PagePadding">24,0,24,0</Thickness>
    <x:Double x:Key="FieldLabelWidth">188</x:Double>

    <!--  文本  -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontPageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="PageDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="GroupTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSectionTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Width" Value="{StaticResource FieldLabelWidth}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="FieldValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <!--  任务管理器"性能"列表的三种字级：标题、数值、次要说明  -->
    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSectionTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="MetricDetailStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  迷你曲线的底框：任务管理器给每条曲线一个带网格的深色小窗口  -->
    <Style x:Key="MetricGraphFrameStyle" TargetType="Border">
        <Setter Property="Width" Value="72" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  卡片与分隔  -->
    <Style x:Key="InfoCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource InfoCardStyle}">
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <Style x:Key="DividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <Style x:Key="AccentRuleStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="15" />
        <Setter Property="RadiusX" Value="1.5" />
        <Setter Property="RadiusY" Value="1.5" />
        <Setter Property="Fill" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  交互控件  -->
    <Style x:Key="SettingCardStyle" TargetType="Border" BasedOn="{StaticResource InfoCardStyle}">
        <Setter Property="Padding" Value="20,14" />
    </Style>

    <!--  设置行：图标 + 标题/说明 + 右侧控件，参考任务管理器的设置页  -->
    <Style x:Key="SettingIconStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Width" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SettingHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  导航列表容器：去掉默认内边距，让卡片铺满内容区  -->
    <Style x:Key="MetricItemContainerStyle" TargetType="GridViewItem">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
</ResourceDictionary>
